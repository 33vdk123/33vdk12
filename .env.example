# انسخ هذا الملف إلى .env.local محليًا — ونفس القيم في Vercel → Settings → Environment Variables
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# رابط مشروع دمج الفيديوهات بعد نشره على Vercel (مجلد merger/)
MERGER_API_BASE=https://<merger-domain>

# اختياري — إن ضُبط MCP_ACCESS_TOKEN يُطلب Bearer token على /mcp
# MCP_ACCESS_TOKEN=
# تجاوز أسماء الموديلات إن لزم
# KIE_IMAGE_MODEL=
# KIE_VIDEO_MODEL=
# COMETAPI_IMAGE_MODEL=
# COMETAPI_VIDEO_MODEL=
